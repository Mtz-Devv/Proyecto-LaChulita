PORT=3000
# Origenes permitidos por CORS: * para red local entre laptops, o lista separada por comas (ej. http://localhost:5173,http://192.168.1.20:5173)
CORS_ORIGIN=*

# mysql si instalaron MySQL Community Server; mariadb si usan XAMPP
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bar
DB_USER=root
DB_PASSWORD=

# Frase secreta para firmar los tokens: cambienla por una larga y que nadie adivine
JWT_SECRET=cambien-esta-frase-por-otra-larga-y-secreta-2026

